# Start the tunnel containers first, then replace these placeholders with the public URLs printed in their logs.
POCKET_ID_URL=https://pocket-id-tunnel.trycloudflare.com
MCP_URL=https://mcp-tunnel.trycloudflare.com

# You can keep it as it is if you only want to try it with Claude, but if you want to add more clients, you can add them here.
CIMD_URL_ALLOWLIST=["https://claude.ai/oauth/mcp-oauth-client-metadata", "https://claude.ai/oauth/claude-code-client-metadata"]